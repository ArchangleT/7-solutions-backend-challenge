# .env.dev.example — Development Environment Configuration
# Copy to .env.dev and fill in actual values (never commit real secrets)
#
# Env vars override config/config_dev.yaml and config/secret_dev.go.
# Only the keys below are read by config/config.go (APP_ENV, PORT, GRPC_PORT,
# MONGO_DATABASE, MONGO_URI, JWT_SECRET); other names are ignored.

APP_ENV=dev
PORT=8080
GRPC_PORT=50051
MONGO_DATABASE=userdb
MONGO_URI=mongodb://localhost:27017
JWT_SECRET=dev-only-jwt-secret